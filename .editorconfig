# EditorConfig - https://editorconfig.org/
# This file ensures consistent coding styles across editors and IDEs

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,toml,yaml,yml}]
indent_size = 2

[*.py]
# Ruff handles formatting, but this helps editors
max_line_length = 100

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_style = space
indent_size = 2
